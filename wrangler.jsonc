{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "share-barabara",
  "compatibility_date": "2026-09-21",
  "routes": [
    {
      "pattern": "sharebarabara.co.ke",
      "zone_name": "sharebarabara.co.ke",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
